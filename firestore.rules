rules_version = '2';
// Deploy: firebase deploy --only firestore:rules
// Or paste into Firebase Console → Firestore → Rules → Publish
//
// Multi-tenant model. A club owns its tournaments and its archive; membership in a
// club is what grants any write at all, so two clubs can never touch each other:
//
//   users/{uid}                          profile written by that user on sign-in
//   clubs/{clubId}                       { name, slug, createdBy, archiveSheetId,
//                                          activeTournamentId }
//   clubs/{clubId}/members/{uid}         { uid, email, role: 'admin'|'scorer', … }
//   clubs/{clubId}/invites/{emailLower}  { email, role, invitedBy, createdAt }
//   clubs/{clubId}/tournaments/{id}      teams, schedule, scores, rosters
//   clubs/{clubId}/players/{playerId}    { name, position, … } — public
//   clubs/{clubId}/playerContacts/{id}   { email, … } — club-private
//   clubs/{clubId}/consentRequests/{tok} { playerId, status } — the emailed link
//   clubs/{clubId}/consents/{tok}        signed waiver — club-private, immutable
//   clubs/{clubId}/archive/snapshot      archived-season snapshot
//   slugs/{slug}                         { clubId } — the public URL reservation
//
// The pre-multi-tenant top-level `tournaments/` and `settings/` documents deliberately
// have no rules here. The migration copies them under a club; the originals stay in
// Firestore as dead weight and become unreachable to clients, which is the intent —
// nothing should keep reading or writing the old single-tenant paths.
service cloud.firestore {
  match /databases/{database}/documents {

    // Super admins see and manage every club. Mirrored to REACT_APP_SUPER_ADMIN_EMAILS
    // for the UI only; that variable decides what the app OFFERS, this list is what is
    // actually enforced, so a direct Firestore call is still stopped here.
    function superAdmins() { return ['logontokartik@gmail.com']; }

    function signedIn()   { return request.auth != null; }
    // `in` on the token map, not `token.email != null` — reading an absent property
    // raises an evaluation error rather than returning null.
    function hasEmail()   { return signedIn() && 'email' in request.auth.token; }
    function verified()   { return hasEmail() && request.auth.token.email_verified == true; }
    function email()      { return request.auth.token.email.lower(); }
    function isSuper()    { return hasEmail() && email() in superAdmins(); }

    function memberRef(clubId) {
      return /databases/$(database)/documents/clubs/$(clubId)/members/$(request.auth.uid);
    }
    function isMember(clubId)  { return signedIn() && exists(memberRef(clubId)); }
    function isClubAdmin(clubId) {
      return isSuper() || (isMember(clubId) && get(memberRef(clubId)).data.role == 'admin');
    }
    // The only fields a scorer may change on a tournament: live scores, and finals
    // results. Teams, schedule, format, name and `rosters` — who is on which team — are
    // all admin territory. Adding a field here is the whole of the decision to let a
    // scorer write it, so new fields are admin-only by default.
    function scorerFieldsOnly() {
      return request.resource.data.diff(resource.data)
        .affectedKeys().hasOnly(['scores', 'finalsMatches']);
    }

    // ---- Legacy single-tenant paths, readable by super admins only ----
    //
    // These are the pre-multi-tenant `tournaments/{id}` and `settings/app` +
    // `settings/archiveSnapshot` documents. The in-app migration runs in the browser as
    // a super admin and has to READ them in order to copy them under a club — with no
    // rule at all they are default-deny and the migration cannot see its own source
    // data. Read-only and super-admin-only: nothing may write them again, and no
    // ordinary visitor can reach them even though they were once world-readable.
    //
    // DELETE THIS BLOCK once the migration has run and the old documents have been
    // removed. It is scaffolding, not part of the model.
    match /tournaments/{tournamentId} {
      allow read: if isSuper();
    }
    match /settings/{docId} {
      allow read: if isSuper();
    }

    // Sign-in upserts { email, displayName, photoURL, lastSeenAt } here. Only the
    // account itself may write it, so a uid can never be impersonated or scraped.
    match /users/{uid} {
      allow read:  if signedIn() && (request.auth.uid == uid || isSuper());
      allow write: if signedIn() && request.auth.uid == uid;
    }

    // "Which clubs am I in / invited to" — collection-group queries. Scoped to your own
    // rows, so these cannot be turned into a directory of everyone's memberships.
    match /{path=**}/members/{memberId} {
      allow read: if signedIn() && resource.data.uid == request.auth.uid;
    }
    match /{path=**}/invites/{inviteId} {
      allow read: if verified() && resource.data.email == email();
    }

    match /slugs/{slug} {
      allow read: if true;
      // Claimable once, by the creator of the club it points at, in the same batch.
      // getAfter() because a batched write is evaluated against pre-batch state, so the
      // club document does not exist yet from get()'s point of view.
      allow create: if signedIn()
        && getAfter(/databases/$(database)/documents/clubs/$(request.resource.data.clubId))
             .data.createdBy == request.auth.uid;
      allow update, delete: if isSuper();
    }

    match /clubs/{clubId} {
      allow read: if true;
      // The mutual check with slugs/ above is what prevents slug squatting: a club may
      // only be created alongside the slug that points back at it, and vice versa.
      // Neither half is safe alone.
      allow create: if signedIn()
        && request.resource.data.createdBy == request.auth.uid
        && getAfter(/databases/$(database)/documents/slugs/$(request.resource.data.slug))
             .data.clubId == clubId;
      // `archiveSheetId` is deliberately NOT club-admin writable. api/ask-archive
      // resolves the spreadsheet from this field server-side and then fetches it on the
      // project's Anthropic key. Since anyone with a Google account can create a club
      // and become its admin, letting a club admin set this field would turn that
      // function into an open, Claude-billed fetch proxy for any spreadsheet on the
      // internet. Attaching an archive is an operator action: super admin only.
      allow update: if isSuper()
        || (isClubAdmin(clubId)
            && !request.resource.data.diff(resource.data)
                 .affectedKeys().hasAny(['archiveSheetId', 'createdBy', 'slug']));
      allow delete: if isSuper();

      // Not publicly readable, unlike everything else under a club: member documents
      // carry email addresses.
      match /members/{uid} {
        allow read: if isMember(clubId) || isSuper();
        // Two separate creates, OR'd. Founding admin: allowed only in the batch that
        // creates the club (hence getAfter again).
        allow create: if signedIn() && uid == request.auth.uid
          && request.resource.data.role == 'admin'
          && request.resource.data.uid == request.auth.uid
          && getAfter(/databases/$(database)/documents/clubs/$(clubId))
               .data.createdBy == request.auth.uid;
        // Claiming an invite: only your own verified address, and pinned to the role the
        // invite named — otherwise an invited scorer could write themselves in as admin.
        allow create: if verified() && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == email()
          && exists(/databases/$(database)/documents/clubs/$(clubId)/invites/$(email()))
          && get(/databases/$(database)/documents/clubs/$(clubId)/invites/$(email()))
               .data.role == request.resource.data.role;
        // Approving a request. Unlike the two above, this one is performed BY an admin
        // FOR someone else — so the thing that makes it safe is the request document,
        // which only that uid can create. No request, no membership: an admin cannot use
        // this to add somebody who never asked. The role is pinned to the two real roles
        // so a typo cannot invent a third.
        allow create: if isClubAdmin(clubId)
          && exists(/databases/$(database)/documents/clubs/$(clubId)/requests/$(uid))
          && request.resource.data.uid == uid
          && request.resource.data.role in ['scorer', 'admin'];
        allow update, delete: if isClubAdmin(clubId);
      }

      // Someone signed in asking a club for scoring access. Keyed by uid, so asking
      // twice updates one row rather than spamming the admin's list.
      match /requests/{uid} {
        // You may only ask on your own behalf, with your own verified address — the
        // address is what the admin sees when deciding.
        allow create, update: if verified() && uid == request.auth.uid
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.email == email();
        // Admins triage; a requester can see their own to know it is still pending.
        // Deliberately not public: a request list is a list of email addresses.
        allow read: if isClubAdmin(clubId) || (signedIn() && uid == request.auth.uid);
        // Admin declines, or the requester withdraws.
        allow delete: if isClubAdmin(clubId) || (signedIn() && uid == request.auth.uid);
      }

      // Doc id is the lowercased invited email, so an invite is looked up by address
      // without a query.
      match /invites/{inviteEmail} {
        allow read:   if isClubAdmin(clubId);
        allow create, update: if isClubAdmin(clubId);
        // The invitee deletes their own invite as they claim it.
        allow delete: if isClubAdmin(clubId) || (verified() && inviteEmail == email());
      }

      match /tournaments/{tournamentId} {
        allow read: if true;
        allow create, delete: if isClubAdmin(clubId);
        allow update: if isClubAdmin(clubId) || (isMember(clubId) && scorerFieldsOnly());
      }

      // The club's player database, deliberately split across two collections.
      //
      // A roster is scoreboard content: the Teams tab is part of the public tournament
      // page, so names and positions are world-readable like every other thing on it.
      // An email address is not. Member documents are already withheld from the public
      // for exactly that reason, and a player list would otherwise be a far easier
      // address book to scrape — nobody even has to be signed in to reach it.
      //
      // So the split is by AUDIENCE, not by convenience: `players` holds what a
      // spectator may see, `playerContacts` holds what only the club may. Anything
      // added later lands in one or the other on the same test — would we print it on
      // a scoreboard? A phone number and an emergency contact go in playerContacts; a
      // jersey number goes in players.
      match /players/{playerId} {
        allow read: if true;
        allow write: if isClubAdmin(clubId);
      }
      // Keyed by the SAME player id, so a contact row is worthless on its own: without
      // the public document it is an email with no name attached to it.
      match /playerContacts/{playerId} {
        allow read: if isMember(clubId) || isSuper();
        allow write: if isClubAdmin(clubId);
      }

      // ---- Participation waivers ----
      //
      // Players mostly do not have accounts and never will, so a waiver has to be
      // signable by someone who is not signed in. The authorisation is the LINK: the
      // document id is 192 bits of CSPRNG (see newConsentToken), and holding it is what
      // permits exactly one signature. That is the same security model as any emailed
      // "confirm your booking" link, and it is why the id must never be derived from a
      // player id or a name.
      match /consentRequests/{token} {
        // `get` only — deliberately NOT `read`, which would also grant `list`. With list
        // the collection could be enumerated and every outstanding link harvested,
        // which would defeat the entire scheme. An admin may list; the public may not.
        allow get:  if true;
        allow list: if isMember(clubId) || isSuper();
        allow create, delete: if isClubAdmin(clubId);
        // The signer flips status to 'signed' and touches nothing else. One-way: a
        // request that has been used cannot be reset by whoever still holds the link,
        // so a leaked link cannot overwrite a signature that already exists.
        allow update: if isClubAdmin(clubId)
          || (resource.data.status == 'pending'
              && request.resource.data.diff(resource.data)
                   .affectedKeys().hasOnly(['status', 'signedAt'])
              && request.resource.data.status == 'signed');
      }

      // The signature itself. Created by an anonymous signer, then never readable by
      // them again: it holds a date of birth and a guardian's contact details, which is
      // the most sensitive data in this database. Club members only.
      match /consents/{token} {
        allow read: if isMember(clubId) || isSuper();
        // Only against a request that exists and is still pending, so a signature cannot
        // be manufactured without a link an admin issued.
        allow create: if exists(/databases/$(database)/documents/clubs/$(clubId)/consentRequests/$(token))
          && get(/databases/$(database)/documents/clubs/$(clubId)/consentRequests/$(token))
               .data.status == 'pending'
          && request.resource.data.token == token
          && request.resource.data.waiverText is string
          && request.resource.data.waiverVersion is string;
        // A signed waiver is a record of what someone agreed to at a moment in time.
        // Nobody edits it — not an admin, not a super admin. Withdrawing consent is a
        // delete, which leaves no altered document to misread later.
        allow update: if false;
        allow delete: if isClubAdmin(clubId);
      }

      match /archive/{docId} {
        allow read: if true;
        allow write: if isClubAdmin(clubId);
      }
    }
  }
}
